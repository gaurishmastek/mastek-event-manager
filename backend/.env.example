# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=mysql+pymysql://mastek:change-me@localhost:3306/mastek_events
ENVIRONMENT=development
# Signs staff tokens and keys OTP hashes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=change-me
# disabled | console (console prints OTPs to stdout, development only)
SMS_PROVIDER=console
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
