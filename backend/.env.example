# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=mysql+pymysql://mastek:change-me@localhost:3306/mastek_events
ENVIRONMENT=development
# Leave these two empty in development to use built-in dev keys. Production refuses to start without real ones.
# Signs staff tokens and keys OTP hashes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts stored guest emails and staff mobiles. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=
# How OTPs and notifications are emailed: disabled | console | smtp
# console prints messages to stdout (development only; refused in production).
EMAIL_PROVIDER=console
# Needed for EMAIL_PROVIDER=smtp. SMTP_SECURITY is starttls (port 587), ssl (port 465) or none (local test servers only).
EMAIL_FROM="Mastek Events <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Anti-abuse caps for OTP emails
OTP_MAX_PER_EMAIL_PER_HOUR=5
OTP_MAX_PER_EMAIL_PER_DAY=10
OTP_MAX_PER_IP_PER_HOUR=20
EMAIL_DAILY_BUDGET=2000
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200
